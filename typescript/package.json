{
  "name": "a2ui-discord",
  "version": "0.1.0-beta.4",
  "description": "Render A2UI 1.0 Basic Catalog surfaces as native Discord Components V2 messages",
  "license": "MIT",
  "author": "tanvesh01",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tanvesh01/a2ui-discord.git",
    "directory": "typescript"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./view": {
      "types": "./dist/view.d.mts",
      "default": "./dist/view.mjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "npm run build && node --test test.mjs test-view.mjs"
  },
  "devDependencies": {
    "@a2ui/web_core": "0.16.1",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@a2ui/web_core": "0.16.1"
  },
  "peerDependenciesMeta": {
    "@a2ui/web_core": {
      "optional": true
    }
  }
}
